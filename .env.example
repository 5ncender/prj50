# 복사해서 .env로 사용: cp .env.example .env
# 노트북에는 개발용 값만 넣는다. 운영 키는 서버의 .env에만 둔다.
# 모든 키는 INVEST_ 접두사 — 셸에 export된 다른 프로젝트 변수와 섞이지 않게.

INVEST_ENV=dev

# 개발용 Docker Postgres (docker-compose.dev.yml과 일치)
INVEST_DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5433/invest

# 원본·Parquet 저장 위치 (기본값: 프로젝트의 data/)
# INVEST_DATA_DIR=/srv/invest/data

# --- 외부 서비스 키 (발급 후 채우기, 비어 있으면 doctor가 '미설정'으로 표시) ---
INVEST_FRED_API_KEY=
INVEST_ECOS_API_KEY=
INVEST_DART_API_KEY=
INVEST_NAVER_CLIENT_ID=
INVEST_NAVER_CLIENT_SECRET=
INVEST_NOTION_TOKEN=
INVEST_TELEGRAM_BOT_TOKEN=
INVEST_TELEGRAM_CHAT_ID=
# SEC EDGAR는 "이름 이메일" 형식의 User-Agent를 요구
INVEST_SEC_USER_AGENT=
INVEST_GOOGLE_CREDENTIALS_FILE=
INVEST_HEALTHCHECKS_URL=
